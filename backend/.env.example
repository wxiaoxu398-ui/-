LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
# bge: full local vector + keyword retrieval; lexical: explicit lightweight mode
EMBEDDING_BACKEND=bge
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
SIMILARITY_THRESHOLD=0.35
BM25_THRESHOLD=1.5
LEXICAL_COVERAGE_THRESHOLD=0.50
RETRIEVE_TOP_K=6
# Without a key, only exact quotations are returned, never generated answers.
ALLOW_EXTRACTIVE=true
